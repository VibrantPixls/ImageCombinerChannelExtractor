<Page x:Class="ImageCombinerChannelExtractor.Components.Pages.CombinerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ImageCombinerChannelExtractor.Components.Pages"
      xmlns:controls="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="602" d:DesignWidth="1000"
      Title="CombinerPage">

    <Grid Grid.Row="1" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="16,0,2,0">
            <controls:ColorChannelInput x:Name="RedChannelInput"
                                    ColorChannel="Red"
                                    ChannelColor="Red"
                                    ChannelClick="OnChannelClick"
                                    ChannelClickRemove="OnChannelClickRemove"
                                    ChannelMouseEnter="OnChannelMouseEnter"
                                    ChannelMouseLeave="OnChannelMouseLeave"
                                    FilteringChanged="OnFilteringChanged"/>

            <controls:ColorChannelInput x:Name="GreenChannelInput"
                                    ColorChannel="Green"
                                    ChannelColor="Green"
                                    ChannelClick="OnChannelClick"
                                    ChannelClickRemove="OnChannelClickRemove"
                                    ChannelMouseEnter="OnChannelMouseEnter"
                                    ChannelMouseLeave="OnChannelMouseLeave"
                                    FilteringChanged="OnFilteringChanged"/>

            <controls:ColorChannelInput x:Name="BlueChannelInput"
                                    ColorChannel="Blue"
                                    ChannelColor="Blue"
                                    ChannelClick="OnChannelClick"
                                    ChannelClickRemove="OnChannelClickRemove"
                                    ChannelMouseEnter="OnChannelMouseEnter"
                                    ChannelMouseLeave="OnChannelMouseLeave"
                                    FilteringChanged="OnFilteringChanged"/>

            <controls:ColorChannelInput x:Name="AlphaChannelInput"
                                    ColorChannel="Alpha"
                                    ChannelColor="WhiteSmoke"
                                    ChannelClick="OnChannelClick"
                                    ChannelClickRemove="OnChannelClickRemove"
                                    ChannelMouseEnter="OnChannelMouseEnter"
                                    ChannelMouseLeave="OnChannelMouseLeave"
                                    FilteringChanged="OnFilteringChanged"/>

            <ui:Card Margin="0,12,0,0" Padding="12" MouseEnter="OnButtonMouseEnterCombined">
                <StackPanel>
                    <ui:Button x:Name="btnCreateCombined" Appearance="Primary" Icon="{ui:SymbolIcon Image24}" HorizontalAlignment="Stretch" Height="36" Content="Create Combined PNG" />
                    <ui:TextBlock x:Name="lblResolutionCombined" FontTypography="Caption" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" HorizontalAlignment="Center" Padding="8">
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="brdPreviewBoxCombined" Width="425" Height="425" CornerRadius="4" ClipToBounds="True">
                        <controls:CheckerboardPictureBox x:Name="imgPreviewCombiner" />
                    </Border>
                    <ui:TextBlock x:Name="lblPreviewCombined" FontTypography="Caption" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
