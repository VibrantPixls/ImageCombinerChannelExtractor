<UserControl x:Class="ImageCombinerChannelExtractor.Components.UserControls.ColorChannelInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400"
             x:Name="Root">
    <Grid MouseEnter="OnButtonMouseEnter" MouseLeave="OnButtonMouseLeave" AllowDrop="True" DragOver="OnButtonDragOver" Drop="OnButtonDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" HorizontalAlignment="Stretch"
                Content="{Binding ColorChannel, ElementName=Root}"
                ContentStringFormat="Select Image for the {0} channel"
                Background="{Binding ChannelColor, ElementName=Root}"
                Click="OnButtonClick"/>
            <Button Grid.Column="1" Content="╳" Click="OnButtonClickRemove"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" x:Name="lblSelectedFile" Grid.Row="1" Content="No Image Selected" />
            <ComboBox Grid.Column="1" x:Name="cmbboxFiltering" SelectionChanged="OnFilteringChange" />
        </Grid>
    </Grid>
</UserControl>
