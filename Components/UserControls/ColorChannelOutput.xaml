<UserControl x:Class="ImageCombinerChannelExtractor.Components.UserControls.ColorChannelOutput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="400">
    <ui:Card x:Name="crdPanel" Padding="12" VerticalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:CheckerboardPictureBox Grid.Column="0" Height="125" Width="125" />
            <ui:Button Grid.Column="1" x:Name="btnDownloadChannel" HorizontalAlignment="Stretch" Appearance="Secondary" Icon="{ui:SymbolIcon ImageAdd24}" Click="OnButtonClick" Height="36" Foreground="White" />
        </Grid>
    </ui:Card>
</UserControl>
