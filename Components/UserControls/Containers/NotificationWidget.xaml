<UserControl x:Class="ImageCombinerChannelExtractor.Components.UserControls.NotificationWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <ScrollViewer x:Name="scrlViewer" VerticalScrollBarVisibility="Hidden">
        <StackPanel x:Name="NotificationContainer" RenderTransformOrigin="0.5,0.5" >
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
        </StackPanel>
    </ScrollViewer>
</UserControl>
