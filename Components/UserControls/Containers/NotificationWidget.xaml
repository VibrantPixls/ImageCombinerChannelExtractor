<UserControl x:Class="ImageCombinerChannelExtractor.Components.UserControls.NotificationWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
             xmlns:classes="clr-namespace:ImageCombinerChannelExtractor.Components.Classes.NoHittable"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <classes:ScrollViewerNoHit x:Name="scrlViewer" VerticalScrollBarVisibility="Hidden" >
        <classes:ScrollViewerNoHit.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                <GradientStop Color="#00000000" Offset="0.0" />
                <GradientStop Color="#FF000000" Offset="0.15" />
                <GradientStop Color="#FF000000" Offset="1.0" />
            </LinearGradientBrush>
        </classes:ScrollViewerNoHit.OpacityMask>

        <!-- Stackpanel should have background, otherwise the panel doesn't fill for the opacity -->
        <classes:StackPanelNoHit x:Name="NotificationContainer" RenderTransformOrigin="0.5,0.5" Background="#00000000" >
            <classes:StackPanelNoHit.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                </TransformGroup>
            </classes:StackPanelNoHit.RenderTransform>
        </classes:StackPanelNoHit>
    </classes:ScrollViewerNoHit>
</UserControl>
