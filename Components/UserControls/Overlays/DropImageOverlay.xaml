<UserControl x:Class="ImageCombinerChannelExtractor.Components.UserControls.DropImageOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="110" d:DesignWidth="466">
    <ui:Card x:Name="bgrPnl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,4,0">
            <ui:SymbolIcon Symbol="ImageAdd24" FontSize="60" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" Margin="0,0,5,0" />
            <TextBlock Text="Drop Image" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center" VerticalAlignment="Center" />
        </StackPanel>
    </ui:Card>
</UserControl>
