<ui:FluentWindow x:Class="ImageCombinerChannelExtractor.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:ImageCombinerChannelExtractor"
                 xmlns:controls="clr-namespace:ImageCombinerChannelExtractor.Components.UserControls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:ImageCombinerChannelExtractor.Components.Pages"
                 mc:Ignorable="d"
                 d:Background="#1C1C1C"
                 Title="Image Combiner &amp; Channel Extractor" 
                 Height="650" Width="1080"
                 MinHeight="650" MaxHeight="650"
                 MinWidth="1080" MaxWidth="1080"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True" WindowStyle="None" ResizeMode="NoResize" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="                   Image Combiner &amp; Channel Extractor" CanMaximize="False" ShowMaximize="False" ApplicationTheme="Dark" />

        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" PaneDisplayMode="LeftFluent" TransitionDuration="300" IsBackButtonVisible="Collapsed" IsFooterSeparatorVisible="False" IsPaneToggleVisible="False" HeaderVisibility="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Combiner" Icon="{ui:SymbolIcon Layer20}" TargetPageType="{x:Type pages:CombinerPage}" Width="80" />
                <ui:NavigationViewItem Content="Extractor" Icon="{ui:SymbolIcon BoardSplit28}" TargetPageType="{x:Type pages:CombinerPage}" Width="80" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <controls:ExportingScreen x:Name="loadingScreen" Grid.Row="1" Visibility="Collapsed"/>
        <controls:NotificationWidget x:Name="notificationWidget" Grid.Row="1" Margin="650,485,16,16"/>
    </Grid>
</ui:FluentWindow>